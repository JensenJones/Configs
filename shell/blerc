# Ctrl+C copies Shift-selected text to the clipboard, otherwise clears the line.
function ble/widget/copy-or-discard {
  if [[ ! $_ble_edit_mark_active ]]; then
    ble/widget/discard-line
    return
  fi
  local a=$_ble_edit_mark b=$_ble_edit_ind
  ((a > b)) && local t=$a a=$b b=$t
  printf %s "${_ble_edit_str:a:b-a}" | wl-copy
  _ble_edit_mark_active=
}
ble-bind -f 'C-c' copy-or-discard

# Tab accepts the grey suggestion when one is showing; otherwise it completes as usual.
blehook/eval-after-load complete "ble-bind -m auto_complete -f C-i 'auto_complete/@end insert'; ble-bind -m auto_complete -f TAB 'auto_complete/@end insert'"
